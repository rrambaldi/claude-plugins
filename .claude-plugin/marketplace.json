      "category": "productivity"
    },
    {
      "name": "all",
      "description": "The whole armamentarium with English command names (instructions stay in Italian): every skill of every plugin, with its hooks. Don't install it together with omnia or tutto.",
      "version": "1.7.0",
      "source": "./",
      "strict": false,
      "skills": [
        "./lingue/en/plugins/make-haste-slowly/skills/the-die-is-cast",
        "./lingue/en/plugins/make-haste-slowly/skills/make-haste-slowly",
        "./lingue/en/plugins/ux-audit/skills/ux-audit",
        "./lingue/en/plugins/ux-audit/skills/apply-restyle",
        "./lingue/en/plugins/critical-review/skills/swot-analysis",
        "./lingue/en/plugins/critical-review/skills/critical-review",
        "./lingue/en/plugins/keep-it-simple/skills/keep-it-simple",
        "./lingue/en/plugins/keep-it-simple/skills/test-first",
        "./lingue/en/plugins/no-delay/skills/no-delay",
        "./lingue/en/plugins/status-line/skills/status-line",
        "./lingue/en/plugins/spellbook/skills/spellbook",
        "./lingue/en/plugins/clean-slate/skills/clean-slate"
      ],
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/lingue/en/plugins/no-delay\" bash \"${CLAUDE_PLUGIN_ROOT}/lingue/en/plugins/no-delay/hooks/session-start.sh\""
              },
              {
                "type": "command",
                "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/lingue/en/plugins/keep-it-simple\" bash \"${CLAUDE_PLUGIN_ROOT}/lingue/en/plugins/keep-it-simple/hooks/load-rules.sh\""
              },
              {
                "type": "command",
                "command": "cat \"${CLAUDE_PLUGIN_ROOT}/lingue/en/plugins/clean-slate/hooks/temp-policy.md\""
              }
            ]
          }
        ],
        "SubagentStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/lingue/en/plugins/keep-it-simple\" bash \"${CLAUDE_PLUGIN_ROOT}/lingue/en/plugins/keep-it-simple/hooks/load-rules.sh\" subagent"
              }
            ]
          }
        ],
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/lingue/en/plugins/keep-it-simple\" bash \"${CLAUDE_PLUGIN_ROOT}/lingue/en/plugins/keep-it-simple/hooks/load-rules.sh\" prompt"
              },
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/lingue/en/plugins/nomen-mutare/hooks/nomen-mutare.py\""
              }
            ]
          }
        ]
      },
      "category": "productivity"
    },
    {
      "name": "limam-adhibere",
      "description": "Pensiero critico su un'idea, niente codice né piani. Limam adhibere / -LA completa, Celeri lima adhibita / -CLA rapida, Advocatus diaboli / -AD solo contro, Intus et extra / -IE analisi SWOT.",
      "version": "1.3.0",
      "source": "./plugins/limam-adhibere",
      "category": "productivity"
    },
    {
      "name": "inspectio-decoris",
      "description": "Analisi UX ed estetica di app web esistenti (Inspectio decoris / -ID) e restyle verificato fase per fase (Sequere pulchritudinem / -SP).",
      "version": "1.1.0",
      "source": "./plugins/inspectio-decoris",
      "category": "development"
    },
    {
      "name": "sine-more-interposita",
      "description": "Modalità di lavoro per tutta la sessione: finire davvero, agire invece di chiedere, andare veloce, risposte corte. /sine-more-interposita o -SMI.",
      "version": "1.3.1",
      "source": "./plugins/sine-more-interposita",
      "category": "productivity"
    },
    {
      "name": "nec-plus-quam-oportet",
      "description": "Modalità di lavoro per tutta la sessione, basata su ponytail: la soluzione più semplice che funziona, riuso di codice e API esistenti, costanti, niente duplicati, DefunctumEst. Include Vitium ostendere / -VO (bug corretti partendo da un test che fallisce). /nec-plus-quam-oportet o -NPQO [levis|ultra|off].",
      "version": "1.2.0",
      "source": "./plugins/nec-plus-quam-oportet",
      "category": "development"
    },
    {
      "name": "status-rei",
      "description": "Statusline su richiesta: modello, effort, cartella, branch, contesto usato, quanto resta dei limiti di 5 ore e settimanale e badge delle modalità attive. /status-rei o -STR (-STR off per disattivare).",
      "version": "1.2.1",
      "source": "./plugins/status-rei",
      "category": "productivity"
    },
    {
      "name": "summa-rerum",
      "description": "Elenca plugin e skill di questo marketplace, con cosa fanno e come si attivano e quali sono sempre attive: l'help del marketplace. /summa-rerum o -SR.",
      "version": "1.2.1",
      "source": "./plugins/summa-rerum",
      "category": "productivity"
    },
    {
      "name": "festina-lente",
      "description": "Eseguire un piano lungo senza di te. Festina lente / -FL: le attività con decisioni che costano refactoring si fermano, si prosegue con le altre, i debiti finiscono in un file da controllare. Alea iacta est / -AIE: Claude decide anche quelle, con tre opzioni, isola la scelta in un punto e la registra in un artefatto.",
      "version": "1.1.0",
      "source": "./plugins/festina-lente",
      "category": "productivity"
    },
    {
      "name": "nomen-mutare",
      "description": "Ogni 10 prompt dà alla sessione un titolo nuovo, come /rename, scritto da Haiku sugli ultimi prompt. Ogni quanti prompt: NOMEN_MUTARE_OGNI nei settings (0 lo spegne).",
      "version": "1.0.0",
      "source": "./plugins/nomen-mutare",
      "category": "productivity"
    },
    {
      "name": "tabula-rasa",
      "description": "Igiene dei file temporanei. Sempre attiva: a ogni avvio carica la regola di cancellare i file temporanei creati nella sessione e chiudere ogni task con lo scratchpad vuoto; dopo commit o push chiede /compact. Tabula rasa / -TR: libera spazio in /tmp (sessioni Claude chiuse, file vecchi, -s solo questa sessione) senza toccare file in uso né di altri utenti.",
      "version": "1.0.0",
      "source": "./plugins/tabula-rasa",
      "category": "productivity"
    }
  ]
}

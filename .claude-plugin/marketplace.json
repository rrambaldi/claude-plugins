{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "armamentarium",
  "version": "1.0.0",
  "description": "Armamentarium: plugin personali per Claude. Un pacchetto li installa tutti insieme, con i comandi in latino (omnia), italiano (tutto) o inglese (all).",
  "owner": {
    "name": "rrambaldi"
  },
  "plugins": [
    {
      "name": "omnia",
      "description": "Tutto l'armamentarium con i comandi in latino: tutte le skill di tutti i plugin, con i loro hook. Non installarlo insieme a tutto o all.",
      "version": "1.7.0",
      "source": "./",
      "strict": false,
      "skills": [
        "./plugins/festina-lente/skills/alea-iacta-est",
        "./plugins/festina-lente/skills/festina-lente",
        "./plugins/inspectio-decoris/skills/inspectio-decoris",
        "./plugins/inspectio-decoris/skills/sequere-pulchritudinem",
        "./plugins/limam-adhibere/skills/intus-et-extra",
        "./plugins/limam-adhibere/skills/limam-adhibere",
        "./plugins/nec-plus-quam-oportet/skills/nec-plus-quam-oportet",
        "./plugins/nec-plus-quam-oportet/skills/vitium-ostendere",
        "./plugins/sine-more-interposita/skills/sine-more-interposita",
        "./plugins/status-rei/skills/status-rei",
        "./plugins/summa-rerum/skills/summa-rerum",
        "./plugins/tabula-rasa/skills/tabula-rasa"
      ],
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/plugins/sine-more-interposita\" bash \"${CLAUDE_PLUGIN_ROOT}/plugins/sine-more-interposita/hooks/session-start.sh\""
              },
              {
                "type": "command",
                "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/plugins/nec-plus-quam-oportet\" bash \"${CLAUDE_PLUGIN_ROOT}/plugins/nec-plus-quam-oportet/hooks/load-rules.sh\""
              },
              {
                "type": "command",
                "command": "cat \"${CLAUDE_PLUGIN_ROOT}/plugins/tabula-rasa/hooks/temp-policy.md\""
              }
            ]
          }
        ],
        "SubagentStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/plugins/nec-plus-quam-oportet\" bash \"${CLAUDE_PLUGIN_ROOT}/plugins/nec-plus-quam-oportet/hooks/load-rules.sh\" subagent"
              }
            ]
          }
        ],
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/plugins/nec-plus-quam-oportet\" bash \"${CLAUDE_PLUGIN_ROOT}/plugins/nec-plus-quam-oportet/hooks/load-rules.sh\" prompt"
              },
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/plugins/nomen-mutare/hooks/nomen-mutare.py\""
              }
            ]
          }
        ]
      },
      "category": "productivity"
    },
    {
      "name": "tutto",
      "description": "Tutto l'armamentarium con i comandi in italiano: tutte le skill di tutti i plugin, con i loro hook. Non installarlo insieme a omnia o all.",
